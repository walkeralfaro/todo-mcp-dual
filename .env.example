# Desarrollo local (SQLite archivo, relativo al schema Prisma => raíz del proyecto)
DATABASE_URL="file:../dev.db"
# Turso vía @prisma/adapter-libsql (ver lib/db.ts: si existe TURSO_DATABASE_URL se usa Turso).
# Convención: MISMO nombre, DISTINTO valor por entorno.
# - En tu `.env` local pon aquí las credenciales de la DB de TEST (vitest/playwright/dev).
# - En el dashboard de Vercel pon las de la DB de PROD (Production/Preview). Los tests NUNCA tocan prod.
# El esquema se aplica con: TURSO_DATABASE_URL=... TURSO_AUTH_TOKEN=... node scripts/apply-schema-turso.mjs
# (el CLI `prisma db push` solo acepta file:, no libsql://)
# TURSO_DATABASE_URL="libsql://..."
# TURSO_AUTH_TOKEN="..."
